<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        A minimal XML theme is still required by the Android framework for the
        window itself (background color, no action bar) before Compose takes
        over. All real styling happens in Jetpack Compose (ui/theme/Theme.kt).
    -->
    <style name="Theme.ARIA" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/aria_background</item>
        <item name="android:statusBarColor">@color/aria_background</item>
        <item name="android:navigationBarColor">@color/aria_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
