<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup / device-transfer rules. Same principle: keep it local. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
