<?xml version="1.0" encoding="utf-8"?>
<!-- ARIA launcher icon foreground: a simple, legible microphone glyph.
     108x108dp canvas; content stays inside the 72dp safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- microphone capsule -->
    <path
        android:fillColor="#6C8BFF"
        android:pathData="M54,30 a11,11 0 0 1 11,11 v15 a11,11 0 0 1 -22,0 v-15 a11,11 0 0 1 11,-11 z" />

    <!-- cradle arc -->
    <path
        android:pathData="M37,55 v2 a17,17 0 0 0 34,0 v-2"
        android:strokeColor="#E6EAF5"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent" />

    <!-- stem + base -->
    <path
        android:pathData="M54,74 v9"
        android:strokeColor="#E6EAF5"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent" />
    <path
        android:pathData="M45,85 h18"
        android:strokeColor="#E6EAF5"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent" />
</vector>
