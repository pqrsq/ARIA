<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        PHASE 2 — the first permission ARIA declares.

        Declaring it does NOT prompt the user. ARIA requests RECORD_AUDIO only
        when the microphone button is tapped (see
        ui/MicrophonePermissionController.kt), which is what Android's
        guidelines require for a microphone.

        Phase 11 will add the sound-mode permissions.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
        Makes this app one of the "speech recognition services" Android can pick
        from (API 30+). It is required for the package visibility rules: without
        it, SpeechRecognizer.isRecognitionAvailable() can report false even when
        a recogniser is installed. It grants no data access whatsoever.
    -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>

        <!--
            PHASE 6 — package visibility for the actions ARIA performs.

            Since Android 11 (API 30) querying PackageManager returns only what is
            declared here. Each entry below is the *narrowest* form that makes one
            Phase 6 feature work, and each is paired with a scheme/host or a
            category so it cannot be read as a blanket "see all apps" request.

            WHY NOT QUERY_ALL_PACKAGES: that permission is for apps whose core
            function is a device-wide app inventory (launchers, antivirus). ARIA
            only launches apps the user names, so an unscoped query would be both
            disproportionate and a Play Store policy problem.
        -->

        <!-- "open Chrome" — every app with a launcher icon becomes a candidate. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>

        <!-- "open maps" / "find a cafe" — geo: URIs. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>

        <!-- "navigate to X" — the de-facto turn-by-turn scheme. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="google.navigation" />
        </intent>

        <!-- "play music" — makes the CATEGORY_APP_MUSIC selector resolvable. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_MUSIC" />
        </intent>
    </queries>

    <application
        android:name=".AriaApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.ARIA">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ARIA"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
